# Mock is the default: zero PayPal requests.
PAYMENT_MODE=mock
PUBLIC_MOCK_JUDGE_MODE=1
PUBLIC_SANDBOX_JUDGE_MODE=0
APP_ORIGIN=http://127.0.0.1:8878
PINPOINT_BACKEND=http://127.0.0.1:8877
PINPOINT_STUDIO_URL=http://127.0.0.1:8877
DB_PATH=./pinpoint-demo.sqlite3
DEMO_ADMIN_TOKEN=replace-with-random-long-token
AUTO_SETTLE_SECONDS=0
REVIEW_TIMEOUT_SECONDS=120
# Optional for a protected, nonpublic Sandbox environment only:
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
AI_API_URL=
AI_API_KEY=
AI_MODEL=
